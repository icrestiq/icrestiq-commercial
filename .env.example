# Copy to .env.local (gitignored) and fill in real values.
# These same two vars must also be set in the Vercel project once deployment
# is set up — see CLAUDE.md.

# Supabase project powering /admin (CRM). Safe to expose client-side — this
# is the publishable/anon key, not a service-role secret; access is
# controlled by Row Level Security policies, not by keeping this key hidden.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key, for the bot-protection challenge on Request
# a Quote (see CLAUDE.md and api/quote/submit.js). Public/safe to expose
# client-side — it only identifies the widget, not a secret. Leave blank
# locally: the widget simply doesn't render, and api/quote/submit.js falls
# back to honeypot + fill-time checks only (see TURNSTILE_SECRET_KEY below).
VITE_TURNSTILE_SITE_KEY=

# --- Server-only — set these in the Vercel project, NOT here -----------
# The Vite dev server never reads them (no VITE_ prefix, by design — a
# VITE_-prefixed var ships to the client bundle, and these must never do
# that). Only api/quote/submit.js (a Vercel serverless function) reads them,
# at request time, via process.env.
#   SUPABASE_SERVICE_ROLE_KEY  — Supabase project Settings → API. Bypasses
#     Row Level Security entirely; this is what lets the API route write to
#     quote_requests now that its public INSERT policy has been removed.
#   TURNSTILE_SECRET_KEY       — Cloudflare Turnstile, same site as
#     VITE_TURNSTILE_SITE_KEY above. Verifies the challenge token server-side.
