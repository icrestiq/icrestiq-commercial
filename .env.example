# Copy to .env.local (gitignored) and fill in real values.
# These same two vars must also be set in the Vercel project once deployment
# is set up — see CLAUDE.md.

# Supabase project powering /admin (CRM). Safe to expose client-side — this
# is the publishable/anon key, not a service-role secret; access is
# controlled by Row Level Security policies, not by keeping this key hidden.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
